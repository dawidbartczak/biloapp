# Integration defaults. Copy service-specific values to local files.
APP_URL=http://localhost
BILO_DOMAIN=:80
INTERNAL_API_URL=http://backend:3001
NEXT_PUBLIC_API_URL=/api/v1

POSTGRES_USER=bilo
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=biloapp_local
DATABASE_URL=postgresql://bilo:change-me-local-only@db:5432/biloapp_local?schema=public

SESSION_SECRET=replace-with-a-random-32-byte-secret
AUDIT_HASHING_SECRET=replace-with-a-distinct-random-secret
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
MAIL_PROVIDER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="BILO Bilety <bilety@biloapp.pl>"
